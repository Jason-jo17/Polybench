FROM node:20-alpine AS builder
WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

# Next.js resolves the /api rewrite at build time, so the backend's address is
# a build argument. docker-compose.yml points it at the backend service.
ARG POLYBENCH_API_URL=http://backend:8000
ENV POLYBENCH_API_URL=$POLYBENCH_API_URL NEXT_TELEMETRY_DISABLED=1

COPY web/ ./
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

USER node
EXPOSE 3000
CMD ["node", "server.js"]
