FROM python:3.12-slim

# Install docker client so the API can launch sandbox containers
RUN apt-get update && apt-get install -y docker.io curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    /root/.local/bin/uv pip install --system "fastapi>=0.111.0" "uvicorn>=0.30.0" "pydantic>=2.7.0" "pydantic-settings>=2.2.0" "sqlmodel>=0.0.21" "psycopg2-binary>=2.9.9" "anthropic>=0.34.0" "openai>=1.40.0" "jinja2>=3.1.0" "rich>=13.7.0" "typer>=0.15.0" "python-multipart>=0.0.9"

# Copy source code and tasks
COPY src/ /app/src/
COPY tasks/ /app/tasks/

ENV PYTHONPATH=/app/src
ENV POLYBENCH_DB=postgresql://user:password@db:5432/polybench

# Default port for FastAPI
EXPOSE 8000

CMD ["uvicorn", "polybench.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
