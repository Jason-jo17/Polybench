FROM python:3.12-slim

# The Docker CLI lets the API build sandbox images and start sandbox containers
# through the host's Docker socket (mounted in docker-compose.yml). The static
# binaries from Docker's official image don't depend on the distro's packaging.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

WORKDIR /app

# Dependencies come from pyproject.toml, so they can't drift from local installs.
COPY pyproject.toml ./
RUN pip install --no-cache-dir uv \
 && uv pip install --system --no-cache -r pyproject.toml

# The code runs from /app/src rather than being pip-installed, because the API
# finds sandbox/ and tasks/ relative to the project directory (/app).
COPY src/ ./src/
COPY sandbox/ ./sandbox/
COPY tasks/ ./tasks/
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "polybench.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
