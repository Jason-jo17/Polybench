# PolyBench API Keys
# Copy this file to .env and fill in the keys for the providers you use.
# The mock provider needs no key.

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
TOGETHER_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""
GEMINI_API_KEY=""
FIREWORKS_API_KEY=""
PERPLEXITY_API_KEY=""

# Local providers (no key needed):
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# LMSTUDIO_BASE_URL="http://localhost:1234/v1"

# POLYBENCH_DB="./polybench.db"
# POLYBENCH_DEFAULT_MODEL="claude-sonnet-4-6"

# Docker Compose database credentials (change POSTGRES_PASSWORD outside local development)
# POSTGRES_USER="user"
# POSTGRES_PASSWORD="password"
# POSTGRES_DB="polybench"

# Dashboard security (optional — leave unset for open local access)
# POLYBENCH_DASHBOARD_PASSWORD="changeme"
# POLYBENCH_MAX_CONCURRENT_RUNS=1
# Samples run in parallel within a run; lower it if sandboxes time out on a busy machine.
# POLYBENCH_SANDBOX_WORKERS=4
